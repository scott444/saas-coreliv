# Postgres (docker compose)
POSTGRES_DB=coreliv
POSTGRES_USER=coreliv
POSTGRES_PASSWORD=coreliv

# API
DATABASE_URL=postgres://coreliv:coreliv@localhost:5433/coreliv
PORT=3000
LOG_LEVEL=info
# Only needed when the SPA is served from a different origin than the API.
# CORS_ORIGINS=http://localhost:5173

# Front end. Vite inlines this at build time.
VITE_API_BASE_URL=/api
# Where `npm run dev` forwards /api. Defaults to http://localhost:3000.
# VITE_PROXY_TARGET=http://localhost:3000

# Host port mappings for docker compose
DB_PORT=5433
API_PORT=3000
WEB_PORT=8082
DEV_PORT=5173
